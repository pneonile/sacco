{
  "name": "kawempe-sacco-api",
  "version": "1.0.0",
  "description": "RESTful API for Kawempe SACCO Management System",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "seed": "ts-node src/database/seeders/index.ts",
    "migrate": "ts-node src/database/migrations/index.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "sacco",
    "microfinance",
    "uganda",
    "financial",
    "api",
    "express"
  ],
  "author": "Paul Neonile",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "pg": "^8.11.3",
    "knex": "^3.1.0",
    "objection": "^3.1.2",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "date-fns": "^3.6.0",
    "axios": "^1.6.2",
    "express-async-errors": "^3.1.1",
    "nodemailer": "^6.9.7",
    "africastalking": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
