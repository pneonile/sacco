# Kawempe SACCO - Environment Configuration
# This is an example configuration file. Copy this to .env and fill in your values.
# NEVER commit the actual .env file to version control

# ----------------------------------------
# API Configuration
# ----------------------------------------
# Base API URL for different environments
NODE_ENV=development
PORT=3000
API_URL_DEVELOPMENT=http://localhost:3000/api/v1
API_URL_PRODUCTION=https://api.kawempesacco.com/api/v1
API_URL_STAGING=https://staging-api.kawempesacco.com/api/v1

# ----------------------------------------
# Database Configuration
# ----------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kawempe_sacco
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=10000

# ----------------------------------------
# Authentication & Security
# ----------------------------------------
# JWT Configuration
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=another_secure_random_string
JWT_REFRESH_EXPIRY=7d

# Password Security
PASSWORD_SALT_ROUNDS=10
PASSWORD_RESET_EXPIRY=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://kawempesacco.com

# ----------------------------------------
# Mobile Money Integration
# ----------------------------------------
# MTN Mobile Money
MTN_API_USER=your_mtn_api_username
MTN_API_KEY=your_mtn_api_key
MTN_PRIMARY_KEY=your_mtn_primary_key
MTN_SECONDARY_KEY=your_mtn_secondary_key
MTN_ENVIRONMENT=sandbox # or production
MTN_CALLBACK_URL=https://api.kawempesacco.com/api/v1/mobile-money/mtn/callback

# Airtel Money
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_PUBLIC_KEY=your_airtel_public_key
AIRTEL_ENVIRONMENT=sandbox # or production
AIRTEL_CALLBACK_URL=https://api.kawempesacco.com/api/v1/mobile-money/airtel/callback

# ----------------------------------------
# Email Configuration
# ----------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_user
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@kawempesacco.com
EMAIL_FROM_NAME=Kawempe SACCO
EMAIL_RATE_LIMIT=100 # emails per hour

# ----------------------------------------
# SMS Configuration
# ----------------------------------------
SMS_PROVIDER=africastalking # or other provider
SMS_API_KEY=your_sms_api_key
SMS_API_USERNAME=your_sms_username
SMS_SENDER_ID=KAWEMPE
SMS_RATE_LIMIT=500 # SMS per hour

# ----------------------------------------
# File Upload Configuration
# ----------------------------------------
# Storage type: local, s3, azure
STORAGE_TYPE=s3

# Local storage config
LOCAL_STORAGE_PATH=./uploads

# S3 storage config
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=kawempe-sacco-files
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com

# File limits
MAX_FILE_SIZE=5242880 # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ----------------------------------------
# Logging & Monitoring
# ----------------------------------------
LOG_LEVEL=info # debug, info, warn, error
ENABLE_REQUEST_LOGGING=true
ENABLE_AUDIT_LOGGING=true
SENTRY_DSN=your_sentry_dsn

# ----------------------------------------
# Rate Limiting
# ----------------------------------------
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------
# External Services
# ----------------------------------------
# Currency conversion API
CURRENCY_API_KEY=your_currency_api_key

# SMS Gateway
SMS_GATEWAY_URL=https://api.africastalking.com/version1/messaging

# ----------------------------------------
# System Settings
# ----------------------------------------
# Default interest rates
DEFAULT_SAVINGS_INTEREST_RATE=8.5
DEFAULT_FIXED_INTEREST_RATE=12.0
DEFAULT_LOAN_INTEREST_RATE=15.0

# Default fine amounts (UGX)
DEFAULT_LATE_PAYMENT_FINE=50000
DEFAULT_MEETING_ABSENCE_FINE=25000

# System maintenance window (UTC time)
MAINTENANCE_START_TIME=01:00
MAINTENANCE_END_TIME=03:00
MAINTENANCE_DAY=Sunday
