# Kawempe SACCO - Development Environment Configuration
# This file contains development settings for the SACCO frontend

# ----------------------------------------
# API Configuration
# ----------------------------------------
NODE_ENV=development
PORT=3000
REACT_APP_API_URL=http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# ----------------------------------------
# Authentication & Security
# ----------------------------------------
# JWT Configuration (for development only)
JWT_SECRET=dev_jwt_secret_key_for_local_testing
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ----------------------------------------
# Mobile Money Integration (Mock Values)
# ----------------------------------------
# MTN Mobile Money (Test/Sandbox)
MTN_API_USER=test_user
MTN_API_KEY=test_api_key
MTN_PRIMARY_KEY=test_primary_key
MTN_SECONDARY_KEY=test_secondary_key
MTN_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=http://localhost:3000/api/v1/mobile-money/mtn/callback

# Airtel Money (Test/Sandbox)
AIRTEL_CLIENT_ID=test_client_id
AIRTEL_CLIENT_SECRET=test_client_secret
AIRTEL_PUBLIC_KEY=test_public_key
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=http://localhost:3000/api/v1/mobile-money/airtel/callback

# ----------------------------------------
# Email Configuration (Development)
# ----------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=test_user
SMTP_PASSWORD=test_password
EMAIL_FROM=dev@kawempesacco.com
EMAIL_FROM_NAME=Kawempe SACCO (Dev)
EMAIL_RATE_LIMIT=100

# ----------------------------------------
# SMS Configuration (Development)
# ----------------------------------------
SMS_PROVIDER=console
SMS_API_KEY=test_sms_api_key
SMS_API_USERNAME=test_sms_username
SMS_SENDER_ID=KAWEMPE-DEV
SMS_RATE_LIMIT=500

# ----------------------------------------
# File Upload Configuration (Development)
# ----------------------------------------
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ----------------------------------------
# Logging & Monitoring (Development)
# ----------------------------------------
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_AUDIT_LOGGING=true

# ----------------------------------------
# System Settings (Development)
# ----------------------------------------
# Default interest rates
DEFAULT_SAVINGS_INTEREST_RATE=8.5
DEFAULT_FIXED_INTEREST_RATE=12.0
DEFAULT_LOAN_INTEREST_RATE=15.0

# Default fine amounts (UGX)
DEFAULT_LATE_PAYMENT_FINE=50000
DEFAULT_MEETING_ABSENCE_FINE=25000

# Feature flags
ENABLE_MOBILE_MONEY=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_DOCUMENT_UPLOAD=true
